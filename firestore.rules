rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar se é psicólogo (Admin)
    function isPsychologist() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'psicologo';
    }

    // --- USERS ---
    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      // Permite que o próprio usuário edite seus dados
      // E permite que o Psicólogo LEIA todos os usuários (para listar no chat e financeiro)
      allow read: if request.auth.uid == userId || isPsychologist();
      allow update: if request.auth.uid == userId;
      allow delete: if false;
    }

    // --- AVAILABILITY ---
    match /availability/{availabilityId} {
      allow create: if isPsychologist();
      allow read: if request.auth != null;
      allow delete: if request.auth != null; // Mantido conforme sua regra atual
      allow update: if false;
    }

    // --- APPOINTMENTS ---
    match /appointments/{appointmentId} {
      allow create: if request.auth.uid == request.resource.data.patientId || isPsychologist();
      // IMPORTANTE: Permitir leitura para todos autenticados para que o calendário mostre "Indisponível"
      allow read: if request.auth != null;
      // O Psicólogo pode atualizar/deletar, e o paciente pode atualizar (para cancelar, por exemplo)
      allow update: if isPsychologist() || request.auth.uid == resource.data.patientId;
      allow delete: if isPsychologist();
    }

    // --- DOCUMENTS ---
    match /documents/{documentId} {
      allow read: if request.auth.uid == resource.data.patientId || isPsychologist();
      allow create: if isPsychologist();
      // Permitir delete para o Admin limpar documentos antigos
      allow delete: if isPsychologist();
      allow update: if false;
    }

    // --- CONTENTS (Para os artigos/vídeos) ---
    match /contents/{contentId} {
      allow read: if request.auth != null;
      allow write: if isPsychologist();
    }

    // --- CHATS (Para as mensagens) ---
    match /chats/{chatId} {
       allow read, write: if request.auth != null && (request.auth.uid == chatId || isPsychologist());

       match /messages/{messageId} {
          allow read, write: if request.auth != null && (request.auth.uid == chatId || isPsychologist());
       }
    }

    // --- INVOICES (Para o financeiro) ---
    match /invoices/{invoiceId} {
       allow read: if request.auth != null && (request.auth.uid == resource.data.patientId || isPsychologist());
       allow write: if isPsychologist();
    }
  }
}
